{
  "description": "Shared PF-S08 duplicate-predicate parity matrix. The C# preview tagger (TransactionService.TagDuplicatesLogic) and the SQL submit RPC (submit_cashflow_import) must both produce `expected` for every case. Rows default to flow CR, account null and statement balance null. `account: \"A\"` means the case owner's single account.",
  "cases": [
    { "name": "exact match",
      "existing": [{ "date": "2026-10-01T10:00:00Z", "description": "GOFOOD BENSU", "amount": "85000" }],
      "incoming": [{ "date": "2026-10-01T10:00:00Z", "description": "GOFOOD BENSU", "amount": "85000" }],
      "expected": [true] },
    { "name": "case and repeated spaces",
      "existing": [{ "date": "2026-10-01T10:00:00Z", "description": "gofood bensu", "amount": "85000" }],
      "incoming": [{ "date": "2026-10-01T10:00:00Z", "description": "  GoFood    BENSU  ", "amount": "85000" }],
      "expected": [true] },
    { "name": "tab, newline and carriage return",
      "existing": [{ "date": "2026-10-01T10:00:00Z", "description": "gofood bensu", "amount": "85000" }],
      "incoming": [{ "date": "2026-10-01T10:00:00Z", "description": "GOFOOD\t\r\nBENSU\n", "amount": "85000" }],
      "expected": [true] },
    { "name": "Unicode space separators",
      "existing": [{ "date": "2026-10-01T10:00:00Z", "description": "a b c d e f g h", "amount": "1" }],
      "incoming": [{ "date": "2026-10-01T10:00:00Z", "description": "a b　c d e f g\u0085h", "amount": "1" }],
      "expected": [true] },
    { "name": "zero-width space is not whitespace",
      "existing": [{ "date": "2026-10-01T10:00:00Z", "description": "GOFOOD", "amount": "1" }],
      "incoming": [{ "date": "2026-10-01T10:00:00Z", "description": "GO​FOOD", "amount": "1" }],
      "expected": [false] },
    { "name": "accented letters fold case",
      "existing": [{ "date": "2026-10-01T10:00:00Z", "description": "café kopi àö", "amount": "1" }],
      "incoming": [{ "date": "2026-10-01T10:00:00Z", "description": "CAFÉ KOPI ÀÖ", "amount": "1" }],
      "expected": [true] },
    { "name": "Greek capital sigma folds without final-sigma context",
      "existing": [{ "date": "2026-10-01T10:00:00Z", "description": "οδοσ", "amount": "1" }],
      "incoming": [{ "date": "2026-10-01T10:00:00Z", "description": "ΟΔΟΣ", "amount": "1" }],
      "expected": [true] },
    { "name": "Turkish dotted capital I folds to plain i",
      "existing": [{ "date": "2026-10-01T10:00:00Z", "description": "istanbul", "amount": "1" }],
      "incoming": [{ "date": "2026-10-01T10:00:00Z", "description": "İSTANBUL", "amount": "1" }],
      "expected": [true] },
    { "name": "same second, different fraction",
      "existing": [{ "date": "2026-10-01T10:00:00.100Z", "description": "X", "amount": "1" }],
      "incoming": [{ "date": "2026-10-01T10:00:00.900Z", "description": "X", "amount": "1" }],
      "expected": [true] },
    { "name": "across a second boundary",
      "existing": [{ "date": "2026-10-01T10:00:00.900Z", "description": "X", "amount": "1" }],
      "incoming": [{ "date": "2026-10-01T10:00:01.100Z", "description": "X", "amount": "1" }],
      "expected": [false] },
    { "name": "same instant in another offset",
      "existing": [{ "date": "2026-10-01T10:00:00Z", "description": "X", "amount": "1" }],
      "incoming": [{ "date": "2026-10-01T17:00:00+07:00", "description": "X", "amount": "1" }],
      "expected": [true] },
    { "name": "midpoint rounds to even (down)",
      "existing": [{ "date": "2026-10-01T10:00:00Z", "description": "X", "amount": "100.00" }],
      "incoming": [{ "date": "2026-10-01T10:00:00Z", "description": "X", "amount": "100.005" }],
      "expected": [true] },
    { "name": "midpoint rounds to even (up)",
      "existing": [{ "date": "2026-10-01T10:00:00Z", "description": "X", "amount": "100.02" }],
      "incoming": [{ "date": "2026-10-01T10:00:00Z", "description": "X", "amount": "100.015" }],
      "expected": [true] },
    { "name": "midpoint does not round away from zero",
      "existing": [{ "date": "2026-10-01T10:00:00Z", "description": "X", "amount": "100.01" }],
      "incoming": [{ "date": "2026-10-01T10:00:00Z", "description": "X", "amount": "100.005" }],
      "expected": [false] },
    { "name": "statement balance NULL is a wildcard on either side",
      "existing": [{ "date": "2026-10-01T10:00:00Z", "description": "X", "amount": "1", "balance": "500" },
                   { "date": "2026-10-01T11:00:00Z", "description": "Y", "amount": "1" }],
      "incoming": [{ "date": "2026-10-01T10:00:00Z", "description": "X", "amount": "1" },
                   { "date": "2026-10-01T11:00:00Z", "description": "Y", "amount": "1", "balance": "500" }],
      "expected": [true, true] },
    { "name": "balance difference below, at and above 0.01",
      "existing": [{ "date": "2026-10-01T10:00:00Z", "description": "A", "amount": "1", "balance": "500" },
                   { "date": "2026-10-01T10:00:00Z", "description": "B", "amount": "1", "balance": "500" },
                   { "date": "2026-10-01T10:00:00Z", "description": "C", "amount": "1", "balance": "500" }],
      "incoming": [{ "date": "2026-10-01T10:00:00Z", "description": "A", "amount": "1", "balance": "500.009" },
                   { "date": "2026-10-01T10:00:00Z", "description": "B", "amount": "1", "balance": "500.01" },
                   { "date": "2026-10-01T10:00:00Z", "description": "C", "amount": "1", "balance": "499.991" }],
      "expected": [true, false, true] },
    { "name": "flow is part of the key",
      "existing": [{ "date": "2026-10-01T10:00:00Z", "description": "X", "amount": "1", "flow": "DB" }],
      "incoming": [{ "date": "2026-10-01T10:00:00Z", "description": "X", "amount": "1", "flow": "CR" }],
      "expected": [false] },
    { "name": "account: null matches null, not an account",
      "existing": [{ "date": "2026-10-01T10:00:00Z", "description": "N", "amount": "1" },
                   { "date": "2026-10-01T10:00:00Z", "description": "M", "amount": "1", "account": "A" }],
      "incoming": [{ "date": "2026-10-01T10:00:00Z", "description": "N", "amount": "1" },
                   { "date": "2026-10-01T10:00:00Z", "description": "M", "amount": "1" },
                   { "date": "2026-10-01T10:00:00Z", "description": "M", "amount": "1", "account": "A" }],
      "expected": [true, false, true] },
    { "name": "repeat inside one batch",
      "existing": [],
      "incoming": [{ "date": "2026-10-01T10:00:00Z", "description": "X", "amount": "1" },
                   { "date": "2026-10-01T10:00:00Z", "description": "x", "amount": "1" }],
      "expected": [false, true] },
    { "name": "non-transitive balance chain inside one batch",
      "existing": [],
      "incoming": [{ "date": "2026-10-01T10:00:00Z", "description": "X", "amount": "1", "balance": "0" },
                   { "date": "2026-10-01T10:00:00Z", "description": "X", "amount": "1", "balance": "0.008" },
                   { "date": "2026-10-01T10:00:00Z", "description": "X", "amount": "1", "balance": "0.016" }],
      "expected": [false, true, false] },
    { "name": "NULL wildcard does not chain to a third balance",
      "existing": [],
      "incoming": [{ "date": "2026-10-01T10:00:00Z", "description": "X", "amount": "1", "balance": "100" },
                   { "date": "2026-10-01T10:00:00Z", "description": "X", "amount": "1" },
                   { "date": "2026-10-01T10:00:00Z", "description": "X", "amount": "1", "balance": "200" }],
      "expected": [false, true, false] },
    { "name": "existing normalized duplicates are kept and still match",
      "existing": [{ "date": "2026-10-01T10:00:00Z", "description": "X", "amount": "1" },
                   { "date": "2026-10-01T10:00:00Z", "description": " x ", "amount": "1" }],
      "incoming": [{ "date": "2026-10-01T10:00:00Z", "description": "X", "amount": "1" }],
      "expected": [true] }
  ]
}
