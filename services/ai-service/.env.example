# ══════════════════════════════════════════════════════════════════
# AI Service environment — services/ai-service/.env
#
# THIS is the AI service's env file. Running locally with `uvicorn`,
# app/config.py reads THIS file exclusively (the path is hard-coded) and
# never the repo-root .env. Set your keys here for local dev.
#
# In Docker Compose the root .env supplies these vars instead, injected
# per docker-compose.yml. If you run both ways, keep the two in sync.
# ══════════════════════════════════════════════════════════════════

# Shared provider/model for extraction and the conversational /advisor.
# Changing these also changes existing AI consumers. Embeddings remain separate.
# Only the active chat/extraction provider key is required. No automatic fallback.
# Switch AI_PROVIDER and AI_MODEL together; obvious model/vendor mismatches fail.
# Advisor limits: 4 model calls/request, 2048 output tokens/call, 30s/call,
# 0 automatic retries (including Google RPC retries). Stop on quota exhaustion.
# Reasoning-token accounting is model-specific; these are not a billing guarantee.
# Active provider: gemini | anthropic
AI_PROVIDER=gemini                          # options: gemini | anthropic

# Residual POST /categorize backend only. Default llm creates no TypeSafe client
# and sends no Jev traffic; extraction, advisors, and suggestions keep AI_PROVIDER.
CATEGORIZATION_BACKEND=llm                  # options: llm | jev
# TYPESAFE_API_KEY=your-typesafe-key-here   # required only when CATEGORIZATION_BACKEND=jev
JEV_MODEL=jev-1.13.0                        # pin the model version used by the approved evaluation
# JEV_ACCEPTANCE_THRESHOLD=<calibrated-value> # required for jev; set only from held-out evaluation evidence
JEV_TIMEOUT_SECONDS=5                       # one attempt, overall deadline; SDK retries are disabled

# Gemini (default — get key at aistudio.google.com)
GEMINI_API_KEY=your-gemini-key-here
AI_MODEL=gemini-2.5-flash                   # if AI_PROVIDER=gemini, options: gemini-2.5-flash | gemini-2.0-flash

# Anthropic (set AI_PROVIDER=anthropic to use)
# ANTHROPIC_API_KEY=your-anthropic-key-here  # get key at console.anthropic.com (separate from a claude.ai chat subscription)
# AI_MODEL=claude-sonnet-4-6                 # if AI_PROVIDER=anthropic, options: claude-sonnet-4-6 (full extraction quality, $3/$15 per 1M in/out) | claude-haiku-4-5 (cheap/fast classification, $0.80/$4 per 1M in/out)

LOG_LEVEL=INFO                              # options: DEBUG | INFO | WARNING | ERROR | CRITICAL

# Embedding provider — independent of AI_PROVIDER (extraction vs. embeddings are separate)
# openai → text-embedding-3-small (requires OPENAI_API_KEY)
# gemini → gemini-embedding-001  (requires GEMINI_API_KEY, free tier)
EMBEDDING_PROVIDER=gemini                   # options: openai | gemini
# EMBEDDING_MODEL=gemini-embedding-001      # optional override — if openai: text-embedding-3-small ($0.02/1M) | text-embedding-3-large ($0.13/1M) | text-embedding-ada-002 ($0.10/1M); if gemini: gemini-embedding-001 (free tier)

# OpenAI (only needed if EMBEDDING_PROVIDER=openai)
# OPENAI_API_KEY=sk-...                     # get key at platform.openai.com — chat/completions models are NOT wired in this service, only embeddings

# Direct Postgres connection for asyncpg (pgvector bypasses PostgREST)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres   # options: local Supabase (above) | Supabase Cloud connection string (Project Settings → Database → Connection string → URI)

#AI Observability
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here   # get keys at cloud.langfuse.com → Project Settings → API Keys
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here
LANGFUSE_HOST="https://cloud.langfuse.com"       # options: https://cloud.langfuse.com (US) | https://cloud.langfuse.com/eu (EU region) | self-hosted URL
LANGFUSE_BASE_URL="https://cloud.langfuse.com"   # keep identical to LANGFUSE_HOST
