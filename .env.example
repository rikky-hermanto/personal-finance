# API Configuration
# Change this to point to your API server
VITE_API_URL=http://localhost:7208
# API CORS origin(s) for the browser; add __1, __2 for additional origins.
Cors__AllowedOrigins__0=http://localhost:8080

# Database Configuration
POSTGRES_DB=personal_finance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# ── AI Service keys ───────────────────────────────────────────────
# Read ONLY by Docker Compose, which injects this into the ai-service
# container (docker-compose.yml: GEMINI_API_KEY=${GEMINI_API_KEY:-};
# same applies to AI_PROVIDER / ANTHROPIC_API_KEY / AI_MODEL).
#
# Running the AI service locally with `uvicorn`? This file is IGNORED —
# the service reads services/ai-service/.env exclusively (path is
# hard-coded in services/ai-service/app/config.py). Put your key there.
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase (backend — server-side operations)
Supabase__Url=https://your-project-ref.supabase.co
Supabase__AnonKey=your-anon-key-here
Supabase__ServiceRoleKey=your-service-role-key-here
# Jwks (default) validates ES256/RS256 against the project's Auth discovery endpoint.
# Use LegacySecret only if the target Auth project still signs user tokens with HS256.
Supabase__JwtValidationMode=Jwks
# Supabase__JwtSecret=your-legacy-hs256-jwt-secret-here
Supabase__JwtIssuer=https://your-project-ref.supabase.co/auth/v1
Supabase__JwtAudience=authenticated
CashflowPilot__Enabled=false
CashflowPilot__CheckedMutationsEnabled=false
AiService__InternalApiKey=replace-with-a-private-service-key
# PF-S15 AI chat (owner-scoped). Enable order: AI service, then API, then frontend; roll back in reverse.
AiChat__Enabled=false
AiChat__AgentsEnabled=false   # PF-S15 Phase 2: /api/chat/advisor; needs AiChat__Enabled and the AI service AI_AGENTS_ENABLED
AiChat__OwnerSigningSecret=replace-with-a-separate-private-signing-secret   # must equal the AI service OWNER_SIGNING_SECRET
