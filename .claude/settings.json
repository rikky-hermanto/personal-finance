{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Edit(*)",
      "Edit(**)",
      "Edit(/**)",
      "Write(*)",
      "Write(**)",
      "Write(/**)",
      "Read(*)",
      "Read(**)",
      "Read(/**)",
      "WebFetch(*)",
      "WebSearch(*)",
      "mcp__playwright__*",
      "mcp__filesystem__*",
      "Skill(*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f*)",
      "Bash(docker system prune*)",
      "Bash(docker volume rm *)",
      "Bash(dotnet ef database drop*)"
    ],
    "additionalDirectories": [
      "c:\\workspaces\\personal-finance\\plans",
      "c:\\workspaces\\personal-finance\\.claude\\skills"
    ]
  },
  "model": "opusplan",
  "includeCoAuthoredBy": false,
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py c:/workspaces/personal-finance/.claude/hooks/plan-complete-sync.py"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|agent_needs_input|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/skills/loop-lib/scripts/prompt-log.mjs\" --root \"$CLAUDE_PROJECT_DIR\""
          }
        ]
      },
      {
        "matcher": "permission_prompt|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/skills/loop-lib/scripts/toast.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/skills/loop-lib/scripts/prompt-log.mjs\" --root \"$CLAUDE_PROJECT_DIR\""
          }
        ]
      }
    ]
  }
}
